# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.
# Les variables préfixées EXPO_PUBLIC_ sont embarquées dans l'application :
# n'y mettre QUE des clés publiques (clé "anon" Supabase, jamais la service_role).

EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique
